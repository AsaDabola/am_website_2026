# Postgres connection string. Vercel's Neon storage integration injects one
# of POSTGRES_URL / DATABASE_URL automatically once connected to the project
# — set DATABASE_URI explicitly only for local development or if you're not
# using the Neon integration.
DATABASE_URI=postgres://user:password@localhost:5432/am_website

# Random secret Payload uses to sign/encrypt sessions and tokens. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Set automatically by Vercel once the Blob store is connected to the
# project. Required locally only if you need to test uploads.
BLOB_READ_WRITE_TOKEN=

# Public URL of the deployed site (used by Payload for admin links/previews).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
